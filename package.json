{
  "name": "biofrontier",
  "version": "0.9.0",
  "description": "A local-first desktop reader for biology frontier updates",
  "main": "out/main/index.cjs",
  "author": "BioFrontier Contributors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "biology",
    "literature",
    "preprint",
    "electron",
    "local-ai"
  ],
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "webpack --config webpack.config.cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node tests/smoke.cjs",
    "test:smoke": "node tests/smoke.cjs",
    "test:packaged": "node tests/packaged-smoke.cjs",
    "preview": "electron .",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "playwright-core": "1.62.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.110.1",
    "webpack-cli": "7.2.3"
  },
  "build": {
    "appId": "com.biofrontier.desktop",
    "productName": "BioFrontier",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "PRIVACY.md",
      "TERMS.md",
      "CONTENT_RIGHTS.md",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "BioFrontier-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BioFrontier-Portable-${version}.${ext}"
    }
  }
}
